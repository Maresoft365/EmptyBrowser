<Page
    x:Class="EmptyBrowser.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EmptyBrowser"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    muxc:BackdropMaterial.ApplyToRootOrPageBackground="True"
    SizeChanged="Page_SizeChanged">

    <Grid>
        <muxc:TabView Name="MicrosoftEdge" 
                      Margin="0,-2,0,0"
                      FontFamily="HarmonyOS Sans SC" 
                      AddTabButtonClick="TabView_AddButtonClick" 
                      TabCloseRequested="TabView_TabCloseRequested" 
                      Loaded="TabView_Loaded" 
                      CloseButtonOverlayMode="OnPointerOver" 
                      HorizontalAlignment="Stretch" 
                      SelectionChanged="MicrosoftEdge_SelectionChanged" 
                      VerticalAlignment="Stretch">
            <muxc:TabView.Resources>
                <!-- 设置标签页圆角为 1px，实现悬浮效果 -->
                <Style TargetType="muxc:TabViewItem">
                    <Setter Property="CornerRadius" Value="1"/>
                </Style>
                <Storyboard x:Name="TitleStoryBoard">
                    <DoubleAnimation x:Name="TitleDTransform" 
                                     Storyboard.TargetName="TitleBarTransform" 
                                     Storyboard.TargetProperty="Y" 
                                     From="0" To="0" Duration="0:0:0.4">
                        <DoubleAnimation.EasingFunction>
                            <ExponentialEase Exponent="8" EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </muxc:TabView.Resources>
            <muxc:TabView.RenderTransform>
                <TranslateTransform x:Name="TitleBarTransform" X="0" Y="0"/>
            </muxc:TabView.RenderTransform>

            <muxc:TabView.TabStripHeader>
                <StackPanel Orientation="Horizontal">
                    <Image Source="Assets/WindowIcon.png" 
                           HorizontalAlignment="Left" VerticalAlignment="Top" 
                           Stretch="Fill" Width="16" Height="16" 
                           Margin="12,11,12,12"/>
                    <Button Name="TabListButton" 
                            Click="TabListButton_Click" 
                            Background="Transparent" 
                            BorderBrush="Transparent" 
                            FontFamily="Segoe Fluent Icons" 
                            Content="&#xE700;" FontSize="16" 
                            Height="36" Width="38" 
                            VerticalAlignment="Center"/>
                </StackPanel>
            </muxc:TabView.TabStripHeader>

            <muxc:TabView.TabStripFooter>
                <!-- 重要：设置 IsHitTestVisible="False" 避免拦截点击 -->
                <Grid x:Name="AppTitleBar" Background="Transparent" Margin="0,0,200,0" IsHitTestVisible="False"/>
            </muxc:TabView.TabStripFooter>
        </muxc:TabView>

        <!-- 侧边栏背景遮罩 -->
        <Grid x:Name="SideWindowBackground" 
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
              CornerRadius="0" Background="Transparent" 
              Margin="0,0,0,0" 
              PointerPressed="SideWindowBackground_PointerPressed" 
              PointerReleased="SideWindowBackground_PointerReleased" 
              Visibility="Collapsed"/>

        <!-- 右侧边栏 -->
        <Grid x:Name="SideGrid" 
              ManipulationDelta="SideGrid_ManipulationDelta" 
              ManipulationMode="TranslateX" 
              ManipulationCompleted="SideGrid_ManipulationCompleted" 
              ManipulationStarted="SideGrid_ManipulationStarted" 
              Margin="0,0,0,0" VerticalAlignment="Stretch" 
              HorizontalAlignment="Right" Visibility="Collapsed" Opacity="1">
            <Grid.Resources>
                <Storyboard x:Name="SideStoryBoard">
                    <DoubleAnimation x:Name="SideFlowIn" 
                                     Storyboard.TargetName="SideGridTransform" 
                                     Storyboard.TargetProperty="X" 
                                     From="0" To="0" Duration="0:0:0.4">
                        <DoubleAnimation.EasingFunction>
                            <ExponentialEase Exponent="8" EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation x:Name="SideOpacity" 
                                     From="1" To="1" 
                                     Storyboard.TargetName="SideGrid" 
                                     Storyboard.TargetProperty="Opacity" 
                                     Duration="0:0:0.1" />
                </Storyboard>
            </Grid.Resources>
            <Grid.RenderTransform>
                <TranslateTransform x:Name="SideGridTransform" X="0" Y="0"/>
            </Grid.RenderTransform>
            <Frame Name="SideWindow" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"/>
            <AppBarSeparator Name="SideSeparateBar" Visibility="Collapsed" 
                             VerticalAlignment="Stretch" HorizontalAlignment="Left" 
                             Margin="-3,-8,-8,-8"/>
        </Grid>

        <!-- 左侧标签页列表背景遮罩 -->
        <Grid x:Name="TabListBackground" 
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
              CornerRadius="0" Background="Transparent" 
              Margin="0,0,0,0" 
              PointerPressed="TabListBackground_PointerPressed" 
              PointerReleased="TabListBackground_PointerReleased" 
              Visibility="Collapsed"/>

        <!-- 左侧标签页列表 -->
        <Grid x:Name="TabListGrid" Margin="0,0,0,0" 
              ManipulationMode="TranslateX" 
              ManipulationCompleted="TabListGrid_ManipulationCompleted" 
              ManipulationStarted="TabListGrid_ManipulationStarted" 
              ManipulationDelta="TabListGrid_ManipulationDelta" 
              VerticalAlignment="Stretch" HorizontalAlignment="Left" 
              Visibility="Collapsed" Opacity="1">
            <Grid.Resources>
                <Storyboard x:Name="TabListStoryBoard">
                    <DoubleAnimation x:Name="TabListFlowIn" 
                                     Storyboard.TargetName="TabListGridTransform" 
                                     Storyboard.TargetProperty="X" 
                                     From="0" To="0" Duration="0:0:0.4">
                        <DoubleAnimation.EasingFunction>
                            <ExponentialEase Exponent="8" EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation x:Name="TabListOpacity" 
                                     From="1" To="1" 
                                     Storyboard.TargetName="TabListGrid" 
                                     Storyboard.TargetProperty="Opacity" 
                                     Duration="0:0:0.1" />
                </Storyboard>
            </Grid.Resources>
            <Grid.RenderTransform>
                <TranslateTransform x:Name="TabListGridTransform" X="0" Y="0"/>
            </Grid.RenderTransform>
            <Frame Name="TabListWindow" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}">
                <Grid>
                    <ListView x:Name="ListView" 
                              HorizontalAlignment="Stretch" 
                              IsItemClickEnabled="True" 
                              ItemClick="TabListView_ItemClick" 
                              VerticalAlignment="Top" 
                              Margin="4,4,8,0" 
                              SelectionChanged="ListView_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:Tab_List">
                                <Grid ToolTipService.ToolTip="{x:Bind Title}" 
                                      AutomationProperties.Name="{x:Bind Title}" 
                                      VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Click="TabListCloseItem_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE711;"/>
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <Image Source="{x:Bind iconSource}" Width="16" Height="16" 
                                           Margin="0,2,8,2" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    <TextBlock VerticalAlignment="Center" FontFamily="HarmonyOS Sans SC" 
                                               Text="{x:Bind Title}" FontSize="12" Margin="24,2,0,2"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Frame>
            <AppBarSeparator Name="TabListSeparateBar" Visibility="Collapsed" 
                             VerticalAlignment="Stretch" HorizontalAlignment="Right" 
                             Margin="-8,-8,-3,-8"/>
        </Grid>

        <!-- 设置面板 - 初始隐藏，避免拦截点击 -->
        <Frame Name="SettingsFrame" 
               Visibility="Collapsed"
               HorizontalAlignment="Stretch" 
               VerticalAlignment="Stretch" 
               Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}" 
               Opacity="0">
            <Frame.Resources>
                <Storyboard x:Name="SettingsStoryBoard">
                    <DoubleAnimation x:Name="SettingsStoryBoardDoubleAnimation" 
                                     From="0" To="1" 
                                     Storyboard.TargetName="SettingsFrame" 
                                     Storyboard.TargetProperty="Opacity" 
                                     Duration="0:0:0.2" />
                </Storyboard>
            </Frame.Resources>
        </Frame>

        <!-- 设置返回按钮 -->
        <StackPanel x:Name="SettingsBackControl" Orientation="Horizontal" 
                    HorizontalAlignment="Left" VerticalAlignment="Top" 
                    Visibility="Collapsed" Margin="2,2,0,0">
            <Button x:Uid="O返回" Name="SettingsBack" Click="SettingsBack_Click" 
                    Background="Transparent" BorderBrush="Transparent" 
                    FontFamily="Segoe Fluent Icons" Content="&#xE112;" 
                    FontSize="14" Height="36" Width="38"/>
        </StackPanel>

        <!-- 退出全屏触发热区 -->
        <Button Name="ExitFS" IsTabStop="False" 
                PointerEntered="ExitFS_PointerEntered" 
                PointerMoved="ExitFS_PointerEntered" 
                HorizontalAlignment="Stretch" VerticalAlignment="Top" 
                Background="Transparent" Height="16" BorderThickness="0" 
                Opacity="0" Visibility="Collapsed" />

        <!-- 底部下载横幅 -->
        <Grid x:Name="DownloadBar"
              HorizontalAlignment="Center"
              VerticalAlignment="Bottom"
              Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}"
              CornerRadius="1"
              Padding="12,6"
              Margin="0,0,0,20"
              Visibility="Collapsed"
              Canvas.ZIndex="100">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <FontIcon x:Name="DownloadIcon"
                      Grid.Column="0"
                      FontFamily="Segoe Fluent Icons"
                      Glyph="&#xE896;"
                      FontSize="16"
                      Margin="0,0,12,0"
                      VerticalAlignment="Center"/>

            <TextBlock x:Name="DownloadStatusText"
                       Grid.Column="1"
                       FontSize="14"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"/>

            <StackPanel x:Name="DownloadingButtons"
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Margin="0,0,8,0">
                <Button x:Name="PauseButton"
                        Content="暂停"
                        Style="{StaticResource TextBlockButtonStyle}"
                        Click="PauseButton_Click"
                        Margin="0,0,8,0"/>
                <Button x:Name="DeleteDuringDownloadButton"
                        Content="删除"
                        Style="{StaticResource TextBlockButtonStyle}"
                        Click="DeleteDuringDownloadButton_Click"/>
            </StackPanel>

            <StackPanel x:Name="CompletedButtons"
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Margin="0,0,8,0"
                        Visibility="Collapsed">
                <Button x:Name="OpenButton"
                        Content="打开"
                        Style="{StaticResource TextBlockButtonStyle}"
                        Click="OpenButton_Click"
                        Margin="0,0,8,0"/>
                <Button x:Name="DeleteCompletedButton"
                        Content="删除"
                        Style="{StaticResource TextBlockButtonStyle}"
                        Click="DeleteCompletedButton_Click"/>
            </StackPanel>

            <Button x:Name="CloseDownloadBarButton"
                    Grid.Column="3"
                    FontFamily="Segoe Fluent Icons"
                    Content="&#xE711;"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    FontSize="12"
                    Width="24"
                    Height="24"
                    Click="CloseDownloadBarButton_Click"/>
        </Grid>
    </Grid>
</Page>